<view class="page">
  <nav-bar title="帮助中心" />
  <view class="title">常见问题</view>
  <view class="hero">
    <image class="hero-img" src="/assets/help-hero.jpg" mode="aspectFill" />
  </view>
  <view class="topic" wx:for="{{topics}}" wx:key="key" data-k="{{item.key}}" bindtap="go">
    <view><view class="topic-cn">{{item.cn}}</view><view class="topic-en">{{item.en}}</view></view>
    <view class="arrow" />
  </view>
</view>
