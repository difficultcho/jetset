<view class="page">
  <view class="hdr" style="padding-top:{{sbh}}px;">
    <view class="hdr-bar"><text class="brand-mark hdr-brand">JET SET</text></view>
    <view class="search-wrap">
      <view class="search-box">
        <view class="ic-search" />
        <input class="search-input" placeholder="搜索商品" placeholder-class="ph" bindconfirm="goSearch" />
      </view>
    </view>
  </view>

  <view class="body">
    <scroll-view class="rail" scroll-y>
      <view class="rail-item {{curKey === item.key ? 'on' : ''}}" wx:for="{{menus}}" wx:key="key" data-i="{{index}}" bindtap="pick">
        <text class="rail-en">{{item.en}}</text>
        <text class="rail-cn">{{item.title}}</text>
      </view>
    </scroll-view>

    <scroll-view class="content" scroll-y>
      <!-- 上部：图片跳链，等宽等高依次罗列；图下可带一行左对齐文字标题 -->
      <view class="bn-cell" wx:for="{{banners}}" wx:key="index" data-i="{{index}}" bindtap="goBanner">
        <view class="bn">
          <image class="bn-img" src="{{item.img}}" mode="aspectFill" />
        </view>
        <text wx:if="{{item.title}}" class="bn-title">{{item.title}}</text>
      </view>

      <!-- 没有下钻入口时（一级类目没建子类、系列也没有可去的类目），
           「全部XX」留在上部图片跳链这一区，不画成子类方块 -->
      <view wx:if="{{cur && !entries.length}}" class="ent" bindtap="goAll">
        <view class="ent-txt"><text class="ent-cn">全部{{cur.title}}</text></view>
        <view class="ent-arrow" />
      </view>

      <!-- 下钻入口：类目的子类，或系列归并出的一级类目。有数据就两列方块 -->
      <view wx:if="{{entries.length}}" class="tiles">
        <view class="tile" wx:for="{{entries}}" wx:key="title" data-i="{{index}}" bindtap="goEntry">
          <view class="tile-img"><prod-img prod="{{item.card}}" /></view>
          <text class="tile-name">{{item.title}}</text>
        </view>
      </view>

      <view wx:if="{{!menus.length}}" class="empty">内容即将上架，敬请期待</view>
      <view class="content-space" />
    </scroll-view>
  </view>

  <fab-stack id="fab" show-bag above-tab />
</view>
