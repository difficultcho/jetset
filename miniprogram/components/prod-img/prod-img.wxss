:host {
  display: block;
  width: 100%;
  height: 100%;
}
.frame {
  position: relative;
  width: 100%;
  height: 100%;
}
.mark {
  position: absolute;
  top: 0;
  right: 0;
  z-index: 2;
  padding: 8rpx 12rpx;
  background: rgba(17, 17, 17, 0.82);
  color: #fff;
  font-size: 20rpx;
  line-height: 1.2;
  letter-spacing: 0.08em;
  pointer-events: none;
}
.real-img {
  width: 100%;
  height: 100%;
  display: block;
}
.ph-solid {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ph-label {
  font-family: monospace;
  font-size: 18rpx;
  letter-spacing: 0.14em;
  color: rgba(90, 70, 55, 0.5);
  padding: 0 20rpx;
  text-align: center;
}
