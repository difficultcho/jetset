# 运行环境: dev | test | prod
APP_ENV=dev

# MySQL（compose 内使用服务名 mysql；本地裸跑可改 127.0.0.1）
DATABASE_URL=mysql+aiomysql://jetset:jetset_pw@mysql:3306/jetset?charset=utf8mb4
# 本地无 MySQL 时可用 sqlite 快速起服务:
# DATABASE_URL=sqlite+aiosqlite:///./jetset.db

REDIS_URL=redis://redis:6379/0

# 启动时自动建表（MVP 阶段开启；schema 稳定后改用 alembic 并关闭）
AUTO_CREATE_TABLES=true

# JWT（生产必须更换，至少 32 字节随机串：openssl rand -hex 32）
JWT_SECRET=change-me-in-prod-0123456789abcdef0123456789abcdef
JWT_EXPIRE_DAYS=30

# 微信小程序
WECHAT_APPID=wxd32004197d4b0d58
WECHAT_SECRET=

# ── 开发期脚手架总开关 ───────────────────────────────────────────────
# true  假登录（code 直接映射 openid）+ 假支付 + 跳过内容安全检测
# false 真实登录 + 真实微信支付 + 真实内容安全检测
#
# 提审前置为 false。切换只改这一处，代码不用动。
# 置 false 时启动会强校验下面 9 项凭据齐全，缺哪项就报哪项、直接拒绝启动。
# 这一项同时关掉假登录。私钥和微信支付公钥只放服务器，不要写进仓库。
MOCK_MODE=true

WXPAY_MCHID=
# 商户 API 证书序列号（不是微信支付公钥 ID）
WXPAY_CERT_SERIAL=
# 商户 API 私钥 PEM 的绝对路径，例如 /opt/jetset/certs/apiclient_key.pem
WXPAY_PRIVATE_KEY_PATH=
# 商户平台「API 安全」里设置的 APIv3 密钥，32 字节
WXPAY_APIV3_KEY=
# 生产回调：https://bce.kkmsee.com/jetset/api/v1/payments/wechat/notify
WXPAY_NOTIFY_URL=
# 微信支付公钥 PEM，以及商户平台给出的公钥 ID（PUB_KEY_ID_ 开头）
WXPAY_PUBLIC_KEY_PATH=
WXPAY_PUBLIC_KEY_ID=

# 订单
ORDER_TIMEOUT_MINUTES=30
FREIGHT_CENTS=0

# 上传（MVP 存本地；接 COS 后替换）
UPLOAD_DIR=./uploads

# 管理后台初始账号（python -m app.seed 时创建；生产务必改密码）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=jetset-admin
